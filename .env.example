# Copy this file to .env.local and fill in your actual Supabase values
# .env.local is gitignored and will NOT be uploaded to GitHub

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Render backend URL — your RotaCatScheduler service URL on Render
# e.g. https://rotacatscheduler.onrender.com
VITE_SCHEDULER_URL=https://your-render-service.onrender.com

# Cloudflare Turnstile site key — public/non-secret by design (it's shipped
# in every page's HTML regardless), pairs with the CAPTCHA secret key
# configured in Supabase's Auth settings (not this repo). Required for
# sign-up/sign-in/password-reset to work once CAPTCHA protection is
# enabled on the Supabase project.
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
